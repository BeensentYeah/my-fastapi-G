# Copy to ".env" and fill in real values. NEVER commit the real .env.
# The same five variables are set in Vercel > Settings > Environment Variables.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key (sb_publishable_... or the legacy anon key). READS only — RLS applies.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Secret key (sb_secret_... or the legacy service_role key). WRITES only.
# Bypasses Row Level Security — server side only, never in a website or in Git.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Read key the three websites send in the x-api-key header.
API_KEY=student-api-key-123

# Admin key required in the x-admin-key header for create, update and delete.
ADMIN_API_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE